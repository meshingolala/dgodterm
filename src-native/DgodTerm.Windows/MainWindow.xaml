<ui:FluentWindow x:Class="DgodTerm.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:models="clr-namespace:DgodTerm.Windows.Models"
        mc:Ignorable="d"
        Title="DgodTerm — Secure Terminal &amp; Fleet Automation"
        Height="820" Width="1440"
        MinHeight="600" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Icon="icon.ico">

    <Window.Resources>
        <!-- Fluent Dark ScrollViewer Style for Tab Strip -->
        <Style x:Key="TabScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="HorizontalScrollBarVisibility" Value="Hidden"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <ScrollContentPresenter CanContentScroll="{TemplateBinding CanContentScroll}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows Terminal Style Native Tab Card -->
        <DataTemplate DataType="{x:Type models:NativeTabItem}">
            <Border x:Name="TabBorder"
                    Height="{Binding TabHeight}"
                    Width="{Binding TabWidth}"
                    Margin="{Binding TabMargin}"
                    Padding="8,0,6,0"
                    CornerRadius="{Binding TabCornerRadius}"
                    Cursor="Hand"
                    ToolTip="{Binding Title}"
                    MouseLeftButtonDown="OnTabClick"
                    MouseDown="OnTabMouseDown">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{Binding CurrentBackground}"/>
                        <Setter Property="BorderBrush" Value="{Binding CurrentBorderBrush}"/>
                        <Setter Property="BorderThickness" Value="{Binding CurrentBorderThickness}"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsActive}" Value="False"/>
                                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="#20888888"/>
                                <Setter Property="BorderBrush" Value="#40888888"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon -->
                    <ui:SymbolIcon Grid.Column="0"
                                   Symbol="{Binding Symbol}"
                                   Foreground="{Binding AccentColor}"
                                   FontSize="13"
                                   Margin="0,0,6,0"
                                   VerticalAlignment="Center"/>

                    <!-- Title -->
                    <TextBlock x:Name="TabTitleText"
                               Grid.Column="1"
                               Text="{Binding Title}"
                               Foreground="{Binding TitleForeground}"
                               FontSize="11.5"
                               FontWeight="{Binding TitleFontWeight}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>

                    <!-- Close Button -->
                    <Border x:Name="CloseBtn"
                            Grid.Column="2"
                            Width="16" Height="16"
                            Margin="4,0,0,0"
                            CornerRadius="3"
                            Background="Transparent"
                            Cursor="Hand"
                            Visibility="{Binding CanClose, Converter={StaticResource BooleanToVisibilityConverter}}"
                            MouseLeftButtonDown="OnTabCloseClick">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#c42b1c"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <ui:SymbolIcon Symbol="Dismiss12"
                                       Foreground="#94a3b8"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="#242627">
        <Grid.RowDefinitions>
            <!-- Single Unified Windows 11 TitleBar: Brand + Tabs + Command Dock + Caption Controls -->
            <RowDefinition Height="40"/>
            <!-- Embedded Native WebView2 Content Area (Directly connected to Tabs above) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!-- Unified Antigravity Studio Top Bar                       -->
        <!-- ======================================================== -->
        <Border x:Name="TitleBarBorder" Grid.Row="0" Background="#242627" BorderBrush="#3A3835" BorderThickness="0,0,0,1" MouseDown="TopBar_MouseDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Column 0: Sidebar Toggle + Brand Logo -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Column 1: Windows Terminal Elastic Tab Strip (+ and v hug last tab) -->
                    <ColumnDefinition Width="*"/>
                    <!-- Column 2: Integrated Windows 11 Quick Command Pill Dock -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Column 3: Windows 11 Fluent Caption Buttons (Min, Max, Close) -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Column 0: Brand Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,6,0">
                    <Border x:Name="BrandBadgeBorder" Width="20" Height="20" CornerRadius="4" Margin="0,0,6,0" VerticalAlignment="Center" ClipToBounds="True">
                        <Image Source="icon.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock x:Name="BrandTitleText" Text="DgodTerm" FontWeight="SemiBold" FontSize="12" Foreground="#D4BE98" VerticalAlignment="Center" Margin="0,0,4,0"/>
                </StackPanel>

                <!-- Column 1: Left-Aligned Elastic Tabs Strip (+ and v sit right next to last tab) -->
                <Grid x:Name="TabStripHostGrid" Grid.Column="1" VerticalAlignment="Stretch" SizeChanged="TabScrollViewer_SizeChanged">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <!-- Scroll Left Button -->
                        <ui:Button x:Name="BtnScrollLeft"
                                   Appearance="Transparent"
                                   Padding="4,2"
                                   Margin="1,0"
                                   Visibility="Collapsed"
                                   ToolTip="Scroll Tabs Left"
                                   Click="BtnScrollLeft_Click">
                            <ui:SymbolIcon Symbol="ChevronLeft16" Foreground="#94a3b8"/>
                        </ui:Button>

                        <!-- Bounded Tab ScrollViewer -->
                        <ScrollViewer x:Name="TabScrollViewer"
                                      Style="{StaticResource TabScrollViewerStyle}"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      PreviewMouseWheel="TabScrollViewer_PreviewMouseWheel"
                                      ScrollChanged="TabScrollViewer_ScrollChanged"
                                      VerticalAlignment="Center">
                            <ItemsControl x:Name="TabStripItemsControl" ItemsSource="{Binding Tabs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Scroll Right Button -->
                        <ui:Button x:Name="BtnScrollRight"
                                   Appearance="Transparent"
                                   Padding="4,2"
                                   Margin="1,0"
                                   Visibility="Collapsed"
                                   ToolTip="Scroll Tabs Right"
                                   Click="BtnScrollRight_Click">
                            <ui:SymbolIcon Symbol="ChevronRight16" Foreground="#94a3b8"/>
                        </ui:Button>

                        <!-- Add Tab (+) Button & Dropdown (Hugs the last tab like Windows Terminal) -->
                        <Border x:Name="AddTabBorder" Background="#242424" BorderBrush="#333333" BorderThickness="1" CornerRadius="5" Margin="4,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <ui:Button x:Name="BtnAddTab"
                                           Appearance="Transparent"
                                           BorderThickness="0"
                                           Padding="6,3"
                                           ToolTip="Open New Terminal Session (Ctrl+T)"
                                           Click="BtnAddTab_Click">
                                    <ui:SymbolIcon x:Name="BtnAddTabIcon" Symbol="Add16" Foreground="#e2e8f0" FontSize="12"/>
                                    <ui:Button.ContextMenu>
                                        <ContextMenu Background="#242424" Foreground="#f1f5f9" BorderBrush="#383838">
                                            <MenuItem Header="Quick SSH Connect..." InputGestureText="Ctrl+K" Click="MenuQuickConnect_Click">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="Flash20" Foreground="#f59e0b"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="New Connection Profile..." InputGestureText="Ctrl+N" Click="MenuNewProfile_Click">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="WindowConsole20" Foreground="#38bdf8"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator Background="#333333"/>
                                            <MenuItem Header="Local PowerShell" InputGestureText="Ctrl+T" Click="MenuNewPowerShell_Click">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="WindowConsole20" Foreground="#06b6d4"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Local Command Prompt" Click="MenuNewCmd_Click">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="WindowConsole20" Foreground="#fbbf24"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="WSL2 (Linux Shell)" Click="MenuNewWsl_Click">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="WindowConsole20" Foreground="#10b981"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Local Unix Terminal (Bash &amp; Coreutils)" Click="MenuNewBash_Click">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="WindowConsole20" Foreground="#c084fc"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator Background="#333333"/>
                                            <MenuItem Header="Dual-Pane SFTP Manager" Click="MenuOpenSftp_Click">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="FolderSwap20" Foreground="#10b981"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Ansible Automation Fleet" Click="MenuOpenAnsible_Click">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="Bot20" Foreground="#818cf8"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="ISO 27001 Cryptographic Audit Trail" Click="MenuOpenAudit_Click">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="ShieldCheckmark20" Foreground="#38bdf8"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </ui:Button.ContextMenu>
                                </ui:Button>

                                <Border Width="1" Background="#333333" Margin="0,4"/>

                                <!-- All Open Tabs Dropdown Menu -->
                                <ui:Button x:Name="BtnTabsOverview"
                                           Appearance="Transparent"
                                           BorderThickness="0"
                                           Padding="5,3"
                                           ToolTip="All Open Tabs &amp; Shell Profiles"
                                           Click="BtnTabsOverview_Click">
                                    <ui:SymbolIcon x:Name="BtnTabsOverviewIcon" Symbol="ChevronDown16" Foreground="#94a3b8" FontSize="11"/>
                                    <ui:Button.ContextMenu>
                                        <ContextMenu x:Name="TabsOverviewContextMenu"
                                                     Background="#242424"
                                                     Foreground="#f1f5f9"
                                                     BorderBrush="#383838"/>
                                    </ui:Button.ContextMenu>
                                </ui:Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Column 2: Sleek Monochrome Studio Command Pill Dock (Integrated into TitleBar Right) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,6,0">
                    <!-- Segmented Workspace Modules Pill (Restrained Monochrome Palette) -->
                    <Border x:Name="CommandDockBorder" Background="#1c1c20" BorderBrush="#2a2a30" BorderThickness="1" CornerRadius="6" Padding="2,1" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- New Profile -->
                            <ui:Button Appearance="Transparent" BorderThickness="0" Padding="7,3" ToolTip="Add New Host Connection Profile (Ctrl+N)" Click="MenuNewProfile_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Add16" Foreground="#a1a1aa" FontSize="11" Margin="0,0,4,0"/>
                                    <TextBlock Text="Host" FontSize="11" Foreground="#d4d4d8" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>

                            <Border Width="1" Background="#2a2a30" Margin="1,4"/>

                            <!-- SFTP File Browser -->
                            <ui:Button Appearance="Transparent" BorderThickness="0" Padding="7,3" ToolTip="Open Dual-Pane SFTP Manager" Click="MenuOpenSftp_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="FolderSwap20" Foreground="#a1a1aa" FontSize="12" Margin="0,0,4,0"/>
                                    <TextBlock Text="SFTP" FontSize="11" Foreground="#d4d4d8" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>

                            <Border Width="1" Background="#2a2a30" Margin="1,4"/>

                            <!-- Ansible Automation Fleet -->
                            <ui:Button Appearance="Transparent" BorderThickness="0" Padding="7,3" ToolTip="Open Ansible Fleet Automation Console" Click="MenuOpenAnsible_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Bot20" Foreground="#a1a1aa" FontSize="12" Margin="0,0,4,0"/>
                                    <TextBlock Text="Ansible" FontSize="11" Foreground="#d4d4d8" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>

                            <Border Width="1" Background="#2a2a30" Margin="1,4"/>

                            <!-- Audit Trail -->
                            <ui:Button Appearance="Transparent" BorderThickness="0" Padding="7,3" ToolTip="ISO/IEC 27001 Cryptographic Audit Trail" Click="MenuOpenAudit_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ShieldCheckmark20" Foreground="#a1a1aa" FontSize="12" Margin="0,0,4,0"/>
                                    <TextBlock Text="Audit" FontSize="11" Foreground="#d4d4d8" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>

                            <Border Width="1" Background="#2a2a30" Margin="1,4"/>

                            <!-- Host Trust Store -->
                            <ui:Button Appearance="Transparent" BorderThickness="0" Padding="7,3" ToolTip="Strict Host Verification Trust Store &amp; Known Hosts" Click="MenuOpenTrust_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Key20" Foreground="#a1a1aa" FontSize="12" Margin="0,0,4,0"/>
                                    <TextBlock Text="Trust" FontSize="11" Foreground="#d4d4d8" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>
                    </Border>

                    <!-- Quick Connect Primary Accent Button -->
                    <Border x:Name="QuickConnectBorder" Background="#0078d4" BorderBrush="#1084df" BorderThickness="1" CornerRadius="5" Padding="1" Margin="0,0,6,0">
                        <ui:Button Appearance="Transparent" BorderThickness="0" Padding="8,3" ToolTip="Quick Connect to SSH Server (Ctrl+K)" Click="MenuQuickConnect_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Flash20" Foreground="White" FontSize="12" Margin="0,0,4,0"/>
                                <TextBlock Text="Quick Connect" FontSize="11" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>
                    </Border>

                    <!-- System Utility Icons (Lock & Settings) -->
                    <Border x:Name="SystemUtilityBorder" Background="#1c1c20" BorderBrush="#2a2a30" BorderThickness="1" CornerRadius="6" Padding="2,1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Appearance="Transparent" BorderThickness="0" Padding="6,3" ToolTip="Lock Workstation (Ctrl+L)" Click="MenuLockWorkstation_Click">
                                <ui:SymbolIcon Symbol="LockClosed20" Foreground="#a1a1aa" FontSize="13"/>
                            </ui:Button>
                            <Border Width="1" Background="#2a2a30" Margin="1,4"/>
                            <ui:Button Appearance="Transparent" BorderThickness="0" Padding="6,3" ToolTip="Settings &amp; Governance (Ctrl+,)" Click="MenuSettings_Click">
                                <ui:SymbolIcon Symbol="Settings20" Foreground="#a1a1aa" FontSize="13"/>
                            </ui:Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Column 3: Pure Windows 11 Native TitleBar (Min, Max, Close) -->
                <ui:TitleBar x:Name="AppTitleBar"
                             Grid.Column="3"
                             Height="42"
                             Title=""
                             ShowMinimize="True"
                             ShowMaximize="True"
                             ShowClose="True"
                             HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- Native WebView2 Container (Directly connected to Tabs)   -->
        <!-- ======================================================== -->
        <Border Grid.Row="1" Background="#202020">
            <wv2:WebView2 Name="MainWebView" DefaultBackgroundColor="#202020"/>
        </Border>
    </Grid>
</ui:FluentWindow>
