{
  "name": "dgodterm",
  "version": "1.0.0",
  "description": "Secure SSH and Ansible Automation Desktop Client",
  "main": "dist/main/main.js",
  "scripts": {
    "build:renderer": "vite build",
    "build:main": "node scripts/generate-icon.js && tsc --project tsconfig.main.json",
    "build": "npm run build:renderer && npm run build:main",
    "start": "electron .",
    "dist": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder",
    "validate:schemas": "node scripts/validate-schemas.js",
    "generate:sbom": "node scripts/generate-sbom.js",
    "test": "npm run validate:schemas && npm run generate:sbom && node scripts/test-integrity.js"
  },
  "build": {
    "appId": "com.dgodterm.app",
    "productName": "DgodTerm",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DgodTerm"
    }
  },
  "keywords": [
    "ssh",
    "ansible",
    "terminal",
    "sftp",
    "security",
    "iso27001",
    "dgodterm"
  ],
  "author": "DgodTerm Team",
  "license": "Apache-2.0",
  "type": "commonjs",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "autoprefixer": "^10.6.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "node-pty": "^1.1.0",
    "postcss": "^8.5.29",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sql.js": "^1.14.2",
    "ssh2": "^1.17.0",
    "tailwindcss": "^4.3.3",
    "uuid": "^14.0.2",
    "vite": "^8.3.3",
    "ws": "^8.22.0"
  }
}
