{
  "policy_id": "default-standalone-v1",
  "name": "Default Standalone Policy",
  "description": "Standard balanced policy for authorized engineers with strict host identity checking and credential protection.",
  "scope": {
    "environments": ["development", "staging"]
  },
  "ssh": {
    "host_key_mode": "strict",
    "allow_legacy_algorithms": false,
    "agent_forwarding": "disabled",
    "x11_forwarding": "disabled",
    "supported_kex": [
      "curve25519-sha256",
      "curve25519-sha256@libssh.org",
      "ecdh-sha2-nistp256",
      "ecdh-sha2-nistp384",
      "diffie-hellman-group14-sha256",
      "diffie-hellman-group16-sha512"
    ],
    "supported_ciphers": [
      "chacha20-poly1305@openssh.com",
      "aes256-gcm@openssh.com",
      "aes128-gcm@openssh.com",
      "aes256-ctr",
      "aes192-ctr",
      "aes128-ctr"
    ]
  },
  "automation": {
    "max_targets_without_approval": 25,
    "production_requires_approval": false,
    "require_change_reference": false,
    "self_approval": true,
    "default_serial": 2,
    "failure_threshold": 2,
    "max_run_minutes": 60
  },
  "credentials": {
    "persistent_passwords": false,
    "require_short_lived_certificates": false
  },
  "logging": {
    "secrets": "never",
    "terminal_recording": "disabled"
  }
}
